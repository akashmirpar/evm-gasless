# Operator wallet that deploys GaslessDelegate and pays gas as the submitter.
# Provide EITHER OPERATOR_PRIVATE_KEY OR OPERATOR_MNEMONIC (+ optional index).

OPERATOR_PRIVATE_KEY=
OPERATOR_MNEMONIC="test test test test test test test test test test test junk"
OPERATOR_MNEMONIC_INDEX=0

# Per-chain RPC overrides. Comma-separated lists; the first is used by the
# deploy script, the backend uses all of them as a fallback chain. If unset,
# the defaults from gasless/chains/chains.json apply.

BSC_RPC_URLS=
BASE_RPC_URLS=
ARBITRUM_RPC_URLS=

# Limit the deploy to a subset of chains (space-separated short names).
# Leave empty to deploy to every chain in chains.json.
CHAINS=

# Etherscan v2 API key. One key works for BSC, Base, Arbitrum, and ~50 other
# chains via api.etherscan.io/v2. Get one at https://etherscan.io/myapikey.
# When set, deploy.sh passes --verify so the explorer shows verified source.
ETHERSCAN_API_KEY=
