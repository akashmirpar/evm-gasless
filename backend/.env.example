# --- docker-compose.dev.yml only ---
# Per-developer suffix appended to container/volume/network names so multiple
# devs can run side-by-side on one host. Required when using compose.
DEV_NAME=local
# Optional image pins (defaults: postgres:16-alpine, redis:7-alpine).
POSTGRES_IMAGE=
REDIS_IMAGE=

# --- HTTP server ---
SERVICE_HOST=0.0.0.0
SERVICE_PORT=3100

# --- Postgres ---
# DATABASE_POSTGRES_HOST is the host the NestJS app reaches Postgres at.
# When the app runs INSIDE the same compose project it's `gasless-postgres`;
# when running on the host against the compose stack it's `127.0.0.1` and the
# port mapping below applies.
DATABASE_POSTGRES_HOST=127.0.0.1
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_USERNAME=gasless
DATABASE_POSTGRES_PASSWORD=gasless
DATABASE_POSTGRES_DATABASE=gasless

# --- Redis (TTL stash for create→submit) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL_SECONDS=300

# --- Chain config locations ---
# Leave blank to use the defaults (gasless/chains/chains.json and
# gasless/chains/deployed.json, resolved relative to the backend source).
# Set absolute paths if your config lives somewhere else.
CHAINS_JSON_PATH=
DEPLOYED_JSON_PATH=

# --- EVM operator wallet ---
# Pays gas as the EIP-7702 type-4 tx sender. Treasury receives the user's fee.
OPERATOR_PRIVATE_KEY=
GASLESS_TREASURY_ADDRESS=

# --- Solana operator wallet ---
# Provide one of:
#   SOLANA_OPERATOR_PRIVATE_KEY (base58 Phantom-format secret, OR a JSON
#     "[1,2,...,64]" array from Solana CLI), OR
#   SOLANA_OPERATOR_MNEMONIC (BIP-39 mnemonic) + SOLANA_OPERATOR_ACCOUNT_INDEX
# Derivation path for the mnemonic form: m/44'/501'/{index}'/0' (Phantom default).
SOLANA_OPERATOR_PRIVATE_KEY=
SOLANA_OPERATOR_MNEMONIC=
SOLANA_OPERATOR_ACCOUNT_INDEX=0
# Base58 pubkey that receives the user's Solana fee payment. Distinct from the
# EVM treasury because Solana addresses are base58, not 0x-prefixed hex.
GASLESS_SOLANA_TREASURY_ADDRESS=
# Default priority fee for the gasless tx (microLamports / compute unit).
# Bump if you see "Solana NetworkCongested" or txs stuck pending.
SOLANA_DEFAULT_PRIORITY_MICROLAMPORTS_PER_CU=1000
# Fallback USD prices for fee quoting. Only used if Rango (which wraps Jupiter
# on Solana) is unreachable. In normal operation the SOL→fee-token conversion
# is fetched live via /basic/quote.
SOLANA_SOL_USD_PRICE=150
SOLANA_FEE_TOKEN_USD_PRICE=1

# Minimum Solana fee floor in lamports. Default 666,666 lamports (~$0.10 at $150 SOL).
# Why: when a user pays in a micro-priced SPL (xTSLA, BONK, meme tokens) and the
# cost-based fee converts to less than DEX pool minimums, Rango/Jupiter returns
# 30002 NO_ROUTE intermittently. Observed reliability vs floor:
#   $0.005 (strict cost) — fails routinely
#   $0.03 worth          — works sometimes; minute-to-minute variation
#   $0.10 worth (default)— essentially always works for mainstream pairs
#   $0.50+ worth         — works for everything including thin meme pools
# Set to 0 to revert to strict cost-based pricing (and accept intermittent
# 30002s on tiny txs). Raise toward 3,333,333 (~$0.50) if you support very
# illiquid long-tail SPLs. The excess over actual SOL cost is operator margin.
SOLANA_MIN_FEE_LAMPORTS=666666

# --- Fee policy ---
# Comma-separated list defining which fee tokens the operator accepts directly
# (no in-tx swap — user transfers the token to treasury and operator off-ramps
# it later off-chain). Three accepted entry formats — mix freely:
#   chainId:SYMBOL          e.g. 56:USDT, -100:USDC, -100:xTSLA
#   chainId:0xtokenaddress  e.g. 56:0x55d398326f99059fF775485246999027B3197955
#   chainId:base58_mint     e.g. -100:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   bare address            e.g. 0x55d398326f99059fF775485246999027B3197955
# IMPORTANT: if NO entry matches a chain, that chain falls back to "accept
# every token configured in chains.json". To opt out of the fallback, list at
# least one entry per chain you support.
#
# Solana sizing note: tokens accepted DIRECTLY skip the in-tx Rango/Jupiter
# swap, which means they don't contribute to the 1232-byte tx size limit.
# Adding xTSLA/xNVDA/xAAPL etc. to this list (rather than letting them route
# through Rango) is the easiest way to support fee-in-arbitrary-SPL even when
# the user intent is itself a bulky bridge or swap.
#
# Example covering EVM stables + Solana USDC + Solana xStocks:
#   GASLESS_ACCEPTED_FEE_TOKENS=56:USDT,8453:USDT,42161:USDT,-100:USDC,-100:xTSLA,-100:xNVDA,-100:xAAPL
GASLESS_ACCEPTED_FEE_TOKENS=56:USDT,8453:USDT,42161:USDT,-100:USDC,-100:xTSLA,-100:xNVDA,-100:xAAPL

# Markup on the raw gas cost (in percent) → operator margin.
GASLESS_BASE_FEE_MARKUP_PERCENT=15
# Fallback gas units if estimation fails.
GASLESS_DEFAULT_GAS_UNITS=1500000
# Hard gas limit on the type-4 envelope.
GASLESS_TX_GAS_LIMIT=2000000
# Slippage to send to Rango for fee-token swaps.
GASLESS_RANGO_SLIPPAGE=0.5
# TTL between createTransaction and submit (Redis stash lifetime).
GASLESS_CREATE_TTL_SECONDS=300

# --- Solana RPC overrides ---
# Comma-separated. Same precedence rule as EVM: when set, REPLACES the public
# defaults in chains.json. Leave empty for public mainnet/devnet RPCs.
SOLANA_RPC_URLS=
SOLANA_DEVNET_RPC_URLS=

# --- Per-chain RPC overrides (comma-separated) ---
# When set, the override REPLACES the defaults from gasless/chains/chains.json
# for that chain — the public defaults are skipped entirely so we don't hit
# rate-limited free endpoints (1rpc.io etc.) when you've configured paid ones.
# When left empty, the chain falls back to the defaults from chains.json.
BSC_RPC_URLS=
BASE_RPC_URLS=
ARBITRUM_RPC_URLS=

# --- Rango ---
RANGO_API_URL=https://api.rango.exchange
RANGO_API_KEY=

# --- Relayer poller ---
RELAYER_CRON=*/5 * * * * *
RELAYER_MAX_RETRIES=6
RELAYER_RETRY_BASE_MS=5000
RELAYER_RETRY_CAP_MS=300000

# --- E2E test wallets (used only by test/e2e/*.e2e-spec.ts) ---
# A funded user EOA that signs the batch.
E2E_USER_PRIVATE_KEY=
# A funded operator EOA that submits the type-4 tx and pays gas. Required for
# `npm run test:e2e` (the spec boots its own backend with testcontainers).
# OPTIONAL for `npm run test:e2e:live` (the running backend already has the key).
E2E_OPERATOR_PRIVATE_KEY=
# Which chain to run e2e against (must have a deployed delegate).
E2E_CHAIN_ID=
E2E_RPC_URL=
E2E_TREASURY_ADDRESS=
# Test fee token for the supported-path test (must be in GASLESS_ACCEPTED_FEE_TOKENS).
E2E_SUPPORTED_FEE_TOKEN=
# Test fee token for the unsupported-path test (NOT in the accepted list).
E2E_UNSUPPORTED_FEE_TOKEN=

# --- Solana e2e wallet (single mnemonic acts as BOTH the test user AND the
# fee-payer operator for the live test) ---
TEST_SOLANA_SENDER_PRIVATE_KEY=
TEST_SOLANA_ACCOUNT_INDEX=0
# Chain id for the Solana e2e (default -100 = mainnet). Use -102 for devnet.
E2E_SOLANA_CHAIN_ID=-100
# Recipient pubkey for the test USDC transfer.
E2E_SOLANA_RECIPIENT=

# Live test (`npm run test:e2e:live`): URL of the already-running backend.
# Defaults to http://localhost:3578 if unset. Use this to exercise the real
# Postgres/Redis from docker-compose.dev.yml instead of testcontainers.
# IMPORTANT: stop `npm run start:dev` before running `npm run test:e2e` —
# both pollers against the same DB will race. `test:e2e:live` is designed
# to run WITH the dev server up.
E2E_BACKEND_URL=
E2E_LIVE=
