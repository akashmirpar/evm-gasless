# ============================================================================
# SECRET / OVERRIDE FILE (copy to ./.env, or mount at /run/secrets/gasless_env)
# ============================================================================
# The app's configuration is the merged result of:
#   1. sample.config.yaml  — non-secret defaults (host/port/tuning knobs)
#   2. THIS file           — secrets + overrides, read by src/config/secret_reader
#      from /run/secrets/gasless_env, then $GASLESS_ENV_FILE, then ./.env
# Any KEY set here OVERRIDES the same flattened key from the YAML, so this file
# is where real secrets (DB/redis passwords, operator private keys, API keys,
# treasury addresses) belong — never inline those in the committed YAML.
#
# The compose-only vars just below (DEV_NAME, *_IMAGE) configure
# docker-compose.dev.yml itself, not the app, and are read from the shell env.
# ============================================================================

# --- docker-compose.dev.yml only ---
# Per-developer suffix appended to container/volume/network names so multiple
# devs can run side-by-side on one host. Required when using compose.
DEV_NAME=local
# Optional image pins (defaults: postgres:16-alpine, redis:7-alpine).
POSTGRES_IMAGE=
REDIS_IMAGE=

# --- HTTP server ---
SERVICE_HOST=0.0.0.0
SERVICE_PORT=3100

# --- Postgres ---
# DATABASE_POSTGRES_HOST is the host the NestJS app reaches Postgres at.
# When the app runs INSIDE the same compose project it's `gasless-postgres`;
# when running on the host against the compose stack it's `127.0.0.1` and the
# port mapping below applies.
DATABASE_POSTGRES_HOST=127.0.0.1
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_USERNAME=gasless
DATABASE_POSTGRES_PASSWORD=gasless
DATABASE_POSTGRES_DATABASE=gasless

# --- Redis (TTL stash for create→submit) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL_SECONDS=300

# --- Delegate registry location ---
# The chain registry lives in config.yaml (chains: section). Only deployed.json
# (generated delegate addresses) is a file. Leave blank to resolve it relative
# to the backend source (gasless/chains/deployed.json); set an absolute path if
# it lives elsewhere.
DEPLOYED_JSON_PATH=

# --- Operator wallet (EVM + Solana fee-payer) ---
# One BIP-39 mnemonic derives BOTH operators: EVM at m/44'/60'/0'/0/{index},
# Solana at m/44'/501'/{index}'/0' (Phantom default). This is the primary path.
OPERATOR_MNEMONIC=
OPERATOR_MNEMONIC_INDEX=0
# Fallbacks (used only when OPERATOR_MNEMONIC is unset):
#   OPERATOR_PRIVATE_KEY                              0x-prefixed EVM key
#   SOLANA_OPERATOR_MNEMONIC + SOLANA_OPERATOR_ACCOUNT_INDEX   legacy Solana mnemonic
#   SOLANA_OPERATOR_PRIVATE_KEY                       base58 Phantom secret OR JSON "[1,..,64]" array
OPERATOR_PRIVATE_KEY=
SOLANA_OPERATOR_MNEMONIC=
SOLANA_OPERATOR_ACCOUNT_INDEX=0
SOLANA_OPERATOR_PRIVATE_KEY=

# Treasuries that receive the user's fee (EVM is 0x hex, Solana is base58).
GASLESS_TREASURY_ADDRESS=
GASLESS_SOLANA_TREASURY_ADDRESS=

# --- RPC provider key ---
# RPC endpoints are public config in config.yaml (chains[].rpcUrls); only the
# provider key is a secret, interpolated into the keyed endpoint via ${ANKR_API_KEY}.
# Unset → the keyed endpoint is dropped and the keyless public fallbacks are used.
ANKR_API_KEY=

# Comma-separated Address Lookup Table pubkeys the backend automatically
# includes in every compiled gasless message. Point this at the operator's
# own ALT (containing operator/treasury/treasury-ATAs/Token programs/
# ComputeBudget) so those accounts collapse from a 32-byte static key each to
# a 1-byte ALT index. Roughly ~30 bytes saved per referenced account —
# critical for heavier Rango bridge routes (Wormhole/Mayan) that already
# consume most of the 1232-byte wire budget.
# Live operator ALT on mainnet: 5cjW5zbejFeF9YFnVnDYuPaU2HWfARGi4jP7hDzmCFBH
SOLANA_OPERATOR_ALT_ADDRESSES=
# --- Priority fee (microLamports / compute unit) ---
# Floor for the priority fee attached to the gasless tx. Used as the fallback
# when SOLANA_DYNAMIC_PRIORITY_ENABLED is false, when the dynamic RPC call
# fails, or when the observed percentile is below this floor.
# Bumped 1000 → 10000 on 2026-07-09. The dynamic priority uses
# getRecentPrioritizationFees scoped to our writable accounts (user's ATAs,
# mint), which typically have NO recent priority-fee history — so p90 comes
# back as 0 and we fall back to this floor. At 1000 μLamports/CU we were
# losing ~75% of the auction under moderate congestion; 10000 is competitive
# with the network baseline (network median is ~3k, we bid at network p90 ish).
# The user still pays this via the fee estimate; operator cost per tx up
# ~$0.005 at $150 SOL.
# Raised 10k → 500k on 2026-07-09 after wallet team's Jupiter xstock swaps kept
# dropping. Two independent factors compounded: (a) getRecentPrioritizationFees
# returns 0 for our writable-accounts scope on both Ankr and mainnet-beta, so
# dynamic-priority always falls to this floor; (b) heavier tx shapes (Jupiter
# swap → ~900B, ~150k CU) need more absolute priority than simple transfers.
# 500k × 200k CU = 100k lamports total — above Jito's 95th-percentile tip
# floor at time of writing. Cost per tx up ~$0.015 at $150 SOL from the old
# 10k floor. Integrators can override per-request via priorityMicroLamportsPerCu
# on /estimate and /transactions.
SOLANA_DEFAULT_PRIORITY_MICROLAMPORTS_PER_CU=500000
# Set false to disable dynamic priority (revert to a static default). Default
# TRUE: at build time we call getRecentPrioritizationFees(writableAccounts)
# and use the Nth percentile (env SOLANA_DYNAMIC_PRIORITY_PERCENTILE, default
# 75) of the last ~150 slots, floored at SOLANA_DEFAULT_PRIORITY_… above and
# ceilinged at SOLANA_MAX_PRIORITY_… below. This lets our txs actually
# compete under congestion instead of losing to any 5000+ μLamports/CU tx.
SOLANA_DYNAMIC_PRIORITY_ENABLED=true
# Bumped 75 → 90 on 2026-07-09 after observing G1 mempool-drop failures under
# real congestion. p75 (~2900 lamports today) loses ~25% of the auction; p90
# (~40k lamports today) is competitive in the top 10% of bids. Cost per tx is
# ~$0.005 more at $150 SOL — acceptable for the reliability gain.
SOLANA_DYNAMIC_PRIORITY_PERCENTILE=90
# Safety ceiling on the dynamic priority fee. Guards against a runaway network
# spike making a tx unaffordable. Operator eats the priority cost; user pays
# a fixed SOL floor via SOLANA_MIN_FEE_LAMPORTS, so the ceiling here is a
# margin-protection knob, not user-facing. Raise if you need reliability under
# extreme congestion; lower to cap operator cost per tx.
# 100_000 μLamports/CU × 400_000 CU budget = 40_000_000 μLamports = 0.04 SOL
# ≈ $6 at $150 SOL — a hard cap on the worst-case priority spend per tx.
# Raised 100k → 300k on 2026-07-09. With PERCENTILE=90 the observed value
# occasionally hits the ceiling under congestion spikes, then gets clamped
# back — defeating the point of aiming at p90. 300k × 400k CU = 120M μLamports
# = 0.12 SOL ≈ $18 max priority per tx worst-case (only during extreme
# congestion; typical is 5-20k lamports).
# Raised 300k → 2M on 2026-07-09. Higher default floor (500k) plus per-request
# override support needs headroom to matter. 2M × 200k CU = 400k lamports max
# priority per tx = ~$0.06 worst case at $150 SOL. Only reached when the caller
# explicitly requests via priorityMicroLamportsPerCu override; the dynamic
# resolution still floors at DEFAULT_PRIORITY above.
SOLANA_MAX_PRIORITY_MICROLAMPORTS_PER_CU=2000000

# --- Solana `bundled` mode (Jito atomic bundle) ---
# `bundled` splits the gasless tx into two txs bundled atomically via Jito:
#   1. Operator-signed prefund tx: SystemProgram.transfer(operator -> user, X)
#      where X = SOL the user needs to pay their tx fee + any ATA rents.
#      Includes Jito tip transfer to a Jito tip account.
#   2. User-signed tx: the actual intent + fee-token TransferChecked to
#      treasury. NO SOL prefund instruction inside — that ~70 bytes freed is
#      what unblocks combined swap-fee + swap-intent, heavier xTSLA/Mayan.
# Both txs are submitted to Jito as a bundle. Either both land in the same
# slot or neither does (atomic). No user co-signature on the prefund tx —
# they still sign one thing, same UX as `single`.
#
# Feature availability: SOLANA_BUNDLED_MODE_ENABLED=true means /estimate and
# /transactions accept an optional `mode: 'single' | 'bundled'` field. When
# false, an explicit `bundled` request is rejected and everything runs `single`
# (classic path).
SOLANA_BUNDLED_MODE_ENABLED=true
# Default mode when caller doesn't specify `mode`. `single` is the safe
# default; auto-fallback in the backend still promotes it to `bundled` when
# the composed single-tx would overshoot 1232B. Accepted values: `single` | `bundled`.
SOLANA_MODE_DEFAULT=single
# Jito block-engine bundle endpoint. Regional variants often give better
# inclusion — pick the one closest to the backend (Frankfurt, London, NY,
# Salt Lake City, Singapore, Tokyo). The bare mainnet URL below routes
# through global load balancing.
SOLANA_JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
# UUID for higher rate limits (only needed at high volume — request via
# Jito Discord ticket per docs.jito.wtf). Empty = public tier: verified
# 1 req/sec/IP PER REGION unauthenticated on 2026-07-10 (Frankfurt / Global /
# NY / Tokyo / Amsterdam all accept unauth requests, return proper JSON-RPC
# errors). At our current rate we don't need one; horizontally shard across
# regions if we ever outgrow a single-region public tier.
SOLANA_JITO_UUID=
# Tip paid to Jito for bundle inclusion (lamports). Minimum is 1000; under
# real congestion the effective tip floor climbs. 5000 (≈ $0.00075) is
# competitive for non-MEV bundles and rarely gets outbid on our volume.
# Bump if you see bundles consistently expiring without inclusion — check
# https://mainnet.block-engine.jito.wtf/api/v1/bundles/tip_floor for the
# current 50/75/95/99th percentile of accepted tips.
SOLANA_JITO_TIP_LAMPORTS=200000
# Max time (seconds) the relayer will keep polling Jito for bundle
# inclusion before giving up. Solana blockhash validity is ~90s so 60s
# leaves a small window to resign+retry.
SOLANA_JITO_BUNDLE_MAX_WAIT_SECONDS=60

# --- Solana broadcast tuning (added 2026-07-08 after kind_crane incident) ---
# Set to false to re-enable RPC-side preflight simulation before broadcast.
# Default TRUE: preflight was rejecting good txs when the specific RPC we hit
# had RPC-lag on blockhash discovery — the leader would have accepted the tx
# but we never got past preflight. With skipPreflight=true, the tx goes
# straight into the tx queue on the RPC; the leader still validates every
# tx so a genuinely-bad tx still fails (just with a different error path).
# Only flip to false if you suspect the client is submitting bad txs and
# you want the RPC to catch them earlier.
SOLANA_BROADCAST_SKIP_PREFLIGHT=true
# web3.js's internal rebroadcast retry count during the blockhash validity
# window. Only functional when skipPreflight=true (in preflight mode
# web3.js retries preflight, not broadcast). Default 5 was bumped from 3
# alongside the preflight change; useful under network congestion.
SOLANA_BROADCAST_MAX_RETRIES=5
# Fallback USD prices for fee quoting. Only used if Rango (which wraps Jupiter
# on Solana) is unreachable. In normal operation the SOL→fee-token conversion
# is fetched live via /basic/quote.
SOLANA_SOL_USD_PRICE=150
SOLANA_FEE_TOKEN_USD_PRICE=1

# Minimum Solana fee floor in lamports. Default 666,666 lamports (~$0.10 at $150 SOL).
# Why: when a user pays in a micro-priced SPL (xTSLA, BONK, meme tokens) and the
# cost-based fee converts to less than DEX pool minimums, Rango/Jupiter returns
# 30002 NO_ROUTE intermittently. Observed reliability vs floor:
#   $0.005 (strict cost) — fails routinely
#   $0.03 worth          — works sometimes; minute-to-minute variation
#   $0.10 worth (default)— essentially always works for mainstream pairs
#   $0.50+ worth         — works for everything including thin meme pools
# Set to 0 to revert to strict cost-based pricing (and accept intermittent
# 30002s on tiny txs). Raise toward 3,333,333 (~$0.50) if you support very
# illiquid long-tail SPLs. The excess over actual SOL cost is operator margin.
SOLANA_MIN_FEE_LAMPORTS=666666

# --- Fee policy ---
# Comma-separated list defining which fee tokens the operator accepts directly
# (no in-tx swap — user transfers the token to treasury and operator off-ramps
# it later off-chain). Three accepted entry formats — mix freely:
#   chainId:SYMBOL          e.g. 56:USDT, -100:USDC, -100:xTSLA
#   chainId:0xtokenaddress  e.g. 56:0x55d398326f99059fF775485246999027B3197955
#   chainId:base58_mint     e.g. -100:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   bare address            e.g. 0x55d398326f99059fF775485246999027B3197955
# IMPORTANT: if NO entry matches a chain, that chain falls back to "accept
# every token configured in config.yaml". To opt out of the fallback, list at
# least one entry per chain you support.
#
# Solana sizing note: tokens accepted DIRECTLY skip the in-tx Rango/Jupiter
# swap, which means they don't contribute to the 1232-byte tx size limit.
# Adding xTSLA/xNVDA/xAAPL etc. to this list (rather than letting them route
# through Rango) is the easiest way to support fee-in-arbitrary-SPL even when
# the user intent is itself a bulky bridge or swap.
#
# Example covering EVM stables + Solana USDC + Solana xStocks:
#   GASLESS_ACCEPTED_FEE_TOKENS=56:USDT,8453:USDT,42161:USDT,-100:USDC,-100:xTSLA,-100:xNVDA,-100:xAAPL
GASLESS_ACCEPTED_FEE_TOKENS=56:USDT,8453:USDT,42161:USDT,-100:USDC,-100:xTSLA,-100:xNVDA,-100:xAAPL

# Fee sizing mode:
#   bps   — (default) spread on top of the network cost via GASLESS_BASE_FEE_MARKUP_PERCENT,
#           exactly the current behavior. No dependency on the price feed.
#   fixed — price the raw network cost into the fee token via the price feed and add a
#           flat per-token profit from GASLESS_FEE_PROFIT. Applies to accepted + native
#           fee tokens; the swap path (arbitrary token) stays on markup+min-floor sizing.
GASLESS_FEE_MODE=bps
# Markup on the raw gas cost (in percent) → operator margin (used by bps mode).
GASLESS_BASE_FEE_MARKUP_PERCENT=15
# fixed-mode per-token profit, human units: <chainId>:<TOKEN_or_address>:<amount>,...
# TOKEN matches either the token address or its symbol (case-insensitive).
#   e.g. -100:xTSLA:0.001,-100:USDC:0.0005,56:USDT:0.002
GASLESS_FEE_PROFIT=
# No-loss ceiling guard: refuse to quote when the fee is worth less than the
# ceiling network cost (simulated + priority headroom), so a priority-fee auction
# move can't push actual cost past what we charged. Requires the price feed.
# Off by default to preserve current behavior; turn on once prices are trusted.
GASLESS_NO_LOSS_CHECK=false
# Echo the `causes` array (Solana program logs, aggregator responses, internal
# error detail) in HTTP error responses. OFF by default — it's a fingerprinting
# surface, and the full detail always goes to the server logs regardless. Turn
# on only for dev/debug environments. Field-level validation errors are always
# returned (they're safe and user-facing).
GASLESS_EXPOSE_ERROR_CAUSES=false
# Headroom above the simulated network cost the no-loss guard must be covered
# for, in basis points. Default 3000 = 30%.
# NOTE: in bps mode the fee is cost × (1 + BASE_FEE_MARKUP_PERCENT). If you turn
# the no-loss guard ON in bps mode, keep BASE_FEE_MARKUP_PERCENT >= this headroom
# (15% < 30% by default) or the guard rejects nearly every quote (40015). fixed
# mode sizes profit per token, so tune GASLESS_FEE_PROFIT above the headroom instead.
GASLESS_PRIORITY_HEADROOM_BPS=3000
# Fallback gas units if estimation fails.
GASLESS_DEFAULT_GAS_UNITS=1500000
# Hard gas limit on the type-4 envelope.
GASLESS_TX_GAS_LIMIT=2000000
# Slippage to send to Rango for fee-token swaps (percent).
# Progression: 0.5 (initial) -> 2.0 (2026-07-07) -> 5.0 (2026-07-08). Each bump
# targeted market-rejection failures where Jupiter's route hits a DEX (Quantum,
# Whirlpool, Meteora, etc.) after a pool-state change between quote and
# execution. At 5.0 the BONK swap-fee scenario that reliably failed at 2.0 with
# Quantum Custom(14) now passes end-to-end (verified 2026-07-08 e2e). Cost: on
# healthy pools this widens the price band the DEX may take, so the operator
# margin on the fee swap is slightly worse; on the DEXes that were rejecting,
# it lets the trade land at all. Only affects the swap-fee path (direct-accepted
# and native-SOL fees don't call Rango). Raise further ONLY if you see repeated
# 30001/30003 market-rejection failures on long-tail SPLs.
GASLESS_RANGO_SLIPPAGE=5.0
# TTL between createTransaction and submit (Redis stash lifetime).
# Default lowered from 300s -> 90s 2026-06-30 to tighten the sign→broadcast race
# window (the user can move tokens out of their wallet between sign and submit;
# shorter TTL shrinks the window without preventing legitimate slow mobile-wallet
# signing flows from completing).
GASLESS_CREATE_TTL_SECONDS=90

# Hard ceiling on the operator → user SOL prefund per tx. Caller-supplied
# `userSolPrefundLamports` and `userSolPrefundExtraLamports` (Solana wire fields)
# are rejected with 40001 if they exceed this value. Auto-scanned prefund (the
# common case — count of user-paid ATA-creates × ATA rent) is also capped here.
# Default 50_000_000 lamports (≈ 0.05 SOL ≈ $7 at $150 SOL) covers ~25 ATA-rent
# payments with margin for known native-fee routes (LayerZero OFT ~0.01 SOL).
# Raise for unusual integrations that need more; lower for tighter budgets.
GASLESS_MAX_PREFUND_LAMPORTS=50000000

# How the Solana user-SOL prefund is sized. In both modes the parallel
# with/without-prefund simulation runs at estimate — it supplies the CU limit and
# revert detection and lets 0-SOL users quote (a plain prefund-less sim falsely
# reverts for them). The mode controls what SIZES the prefund:
#   simulate (default) size by simulation: the exact SOL the user consumes, floored
#            at the scan so it never under-provisions; 0 when the user self-covers.
#            Applies to the direct-accepted-SPL path (at estimate) and the swap-fee
#            path (at create, over swap+intent). The native-SOL-fee path keeps the
#            scan. Logs scan-vs-sim-vs-applied on every sized request. Falls back
#            to the scan (with a warn) if simulation is unavailable.
#   scan     size from a static ATA-create scan of the intent only. Blind to any
#            SOL cost that isn't a user-paid ATA create (bridge native fees,
#            wrap/unwrap peaks) — this is the automatic fallback when simulation
#            is unavailable and an emergency opt-out, not an operating mode.
GASLESS_PREFUND_SIZING=simulate

# RPC endpoints are public config in config.yaml (chains[].rpcUrls). To change
# them, edit config.yaml — there are no per-chain *_RPC_URLS env overrides. The
# only RPC secret is ANKR_API_KEY (above), interpolated into the keyed endpoint.

# --- Rango ---
RANGO_API_URL=https://api.rango.exchange
RANGO_API_KEY=

# --- Token price feed ---
# TokenPriceRefreshJob pulls the full Rango /basic/meta token list on this cron
# and stores every USD price in Redis (single blob) for the fee estimator to
# read. Also runs once on boot so a fresh process has prices before the first
# tick. Default every 5 minutes.
GASLESS_PRICE_REFRESH_CRON=*/5 * * * *
# The estimator treats the price blob as unusable once it is older than this,
# so a wedged *local* refresh job cannot silently under-price (it fails closed
# with PriceUnavailable instead). Note: this guards against our job stalling,
# not against Rango itself serving stale-but-fresh-looking prices. Default 900s
# = three refresh intervals.
GASLESS_PRICE_MAX_AGE_SECONDS=900

# --- Relayer poller ---
RELAYER_CRON=*/5 * * * * *
RELAYER_MAX_RETRIES=6
RELAYER_RETRY_BASE_MS=5000
RELAYER_RETRY_CAP_MS=300000

# --- E2E test wallets (used only by test/e2e/*.e2e-spec.ts) ---
# One BIP-39 mnemonic derives EVERY e2e wallet: EVM at m/44'/60'/0'/0/{index},
# Solana at m/44'/501'/{index}'/0'. Per-role EVM indices below (user 0, operator 1).
TEST_MNEMONIC=
TEST_EVM_USER_INDEX=0
TEST_EVM_OPERATOR_INDEX=1
TEST_SOLANA_ACCOUNT_INDEX=0
# Fallbacks (used only when TEST_MNEMONIC is unset): raw per-role keys.
E2E_USER_PRIVATE_KEY=
E2E_OPERATOR_PRIVATE_KEY=
# Which chain to run e2e against (must have a deployed delegate).
E2E_CHAIN_ID=
E2E_RPC_URL=
E2E_TREASURY_ADDRESS=
# Test fee token for the supported-path test (must be in GASLESS_ACCEPTED_FEE_TOKENS).
E2E_SUPPORTED_FEE_TOKEN=
# Test fee token for the unsupported-path test (NOT in the accepted list).
E2E_UNSUPPORTED_FEE_TOKEN=
# Chain id for the Solana e2e (default -100 = mainnet). Use -102 for devnet.
E2E_SOLANA_CHAIN_ID=-100
# Recipient pubkey for the test USDC transfer.
E2E_SOLANA_RECIPIENT=

# Live test (`npm run test:e2e:live`): URL of the already-running backend.
# Defaults to http://localhost:3578 if unset. Use this to exercise the real
# Postgres/Redis from docker-compose.dev.yml instead of testcontainers.
# IMPORTANT: stop `npm run start:dev` before running `npm run test:e2e` —
# both pollers against the same DB will race. `test:e2e:live` is designed
# to run WITH the dev server up.
E2E_BACKEND_URL=
E2E_LIVE=
