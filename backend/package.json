{
  "name": "gasless-backend",
  "version": "0.1.0",
  "description": "Gasless transaction relayer service. Estimates fees, builds EIP-712 batches, broadcasts EIP-7702 type-4 transactions.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/core/database/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create src/core/database/migrations/$npm_config_name",
    "migration:generate": "typeorm migration:generate -d dist/core/database/data-source.js",
    "migration:run": "typeorm migration:run -d dist/core/database/data-source.js"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "11.0.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.8",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/platform-express": "11.0.8",
    "@nestjs/schedule": "5.0.1",
    "@nestjs/swagger": "11.0.3",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/typeorm": "11.0.0",
    "axios": "^1.7.7",
    "bignumber.js": "^9.1.2",
    "cache-manager": "6.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cron": "3.5.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "ioredis": "5.6.1",
    "js-sha3": "^0.9.3",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.21",
    "typeorm-naming-strategies": "4.1.0",
    "uuid": "11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.2",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.4",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "jest": "29.7.0",
    "prettier": "3.5.1",
    "supertest": "7.0.0",
    "testcontainers": "10.16.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": ["reflect-metadata"],
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node",
    "moduleNameMapper": { "^src/(.*)$": "<rootDir>/$1" }
  }
}
